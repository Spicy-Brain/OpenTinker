{
    "name": "opentinker",
    "displayName": "OpenTinker",
    "description": "Scratchpad for Laravel and PHP: run code in your app's real runtime (Docker, local PHP or SSH) and see every line's result, with model cards, SQL insight and production safety.",
    "version": "0.3.0",
    "publisher": "snitzle",
    "license": "MIT",
    "private": true,
    "engines": {
        "vscode": "^1.90.0",
        "node": ">=22"
    },
    "categories": [
        "Programming Languages",
        "Other"
    ],
    "keywords": [
        "laravel",
        "php",
        "tinker",
        "psysh",
        "repl",
        "scratchpad",
        "playground",
        "eloquent",
        "artisan",
        "docker",
        "sail",
        "ssh"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/Spicy-Brain/OpenTinker.git"
    },
    "bugs": {
        "url": "https://github.com/Spicy-Brain/OpenTinker/issues"
    },
    "homepage": "https://github.com/Spicy-Brain/OpenTinker#readme",
    "icon": "media/icon.png",
    "galleryBanner": {
        "color": "#1E1B4B",
        "theme": "dark"
    },
    "preview": true,
    "extensionKind": [
        "workspace"
    ],
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": false,
            "description": "OpenTinker runs PHP code in your app's runtime, so it only works in trusted workspaces."
        },
        "virtualWorkspaces": {
            "supported": false,
            "description": "OpenTinker needs local files and runs PHP, Docker or SSH processes."
        }
    },
    "main": "./dist/extension.js",
    "activationEvents": [
        "onLanguage:php",
        "workspaceContains:artisan",
        "workspaceContains:composer.json"
    ],
    "contributes": {
        "commands": [
            {
                "command": "opentinker.open",
                "title": "Open Tinker Window",
                "category": "OpenTinker",
                "icon": "$(beaker)"
            },
            {
                "command": "opentinker.run",
                "title": "Run",
                "category": "OpenTinker",
                "enablement": "editorLangId == php",
                "icon": "$(play)"
            },
            {
                "command": "opentinker.runFile",
                "title": "Run Scratch File",
                "category": "OpenTinker",
                "icon": "$(run-all)"
            },
            {
                "command": "opentinker.runSelection",
                "title": "Run Selection or Line",
                "category": "OpenTinker",
                "enablement": "editorLangId == php"
            },
            {
                "command": "opentinker.runClipboard",
                "title": "Run Clipboard",
                "category": "OpenTinker"
            },
            {
                "command": "opentinker.stop",
                "title": "Stop Run",
                "category": "OpenTinker",
                "icon": "$(debug-stop)"
            },
            {
                "command": "opentinker.rerun",
                "title": "Run Again",
                "category": "OpenTinker"
            },
            {
                "command": "opentinker.newScratch",
                "title": "New Scratch File",
                "category": "OpenTinker",
                "icon": "$(new-file)"
            },
            {
                "command": "opentinker.openScratch",
                "title": "Open Scratch File…",
                "category": "OpenTinker"
            },
            {
                "command": "opentinker.selectTarget",
                "title": "Choose Target…",
                "category": "OpenTinker",
                "icon": "$(server-environment)"
            },
            {
                "command": "opentinker.selectTargetForFile",
                "title": "Choose Target for This File…",
                "category": "OpenTinker"
            },
            {
                "command": "opentinker.newTarget",
                "title": "New Target…",
                "category": "OpenTinker"
            },
            {
                "command": "opentinker.editTarget",
                "title": "Edit Target…",
                "category": "OpenTinker",
                "icon": "$(gear)"
            },
            {
                "command": "opentinker.toggleSessionMode",
                "title": "Toggle Fresh / Keep Session",
                "category": "OpenTinker"
            },
            {
                "command": "opentinker.toggleRollback",
                "title": "Toggle Database Rollback",
                "category": "OpenTinker"
            },
            {
                "command": "opentinker.toggleFakes",
                "title": "Toggle Fake Side Effects",
                "category": "OpenTinker"
            },
            {
                "command": "opentinker.restartSession",
                "title": "Reset Kept Session",
                "category": "OpenTinker",
                "icon": "$(debug-restart)"
            },
            {
                "command": "opentinker.saveSnippet",
                "title": "Save Snippet",
                "category": "OpenTinker",
                "icon": "$(save)"
            },
            {
                "command": "opentinker.runSnippet",
                "title": "Run Snippet…",
                "category": "OpenTinker",
                "icon": "$(play)"
            },
            {
                "command": "opentinker.openSnippet",
                "title": "Edit Snippet",
                "category": "OpenTinker",
                "icon": "$(edit)"
            },
            {
                "command": "opentinker.searchHistory",
                "title": "Search Run History",
                "category": "OpenTinker",
                "icon": "$(search)"
            },
            {
                "command": "opentinker.clearHistory",
                "title": "Clear Run History",
                "category": "OpenTinker"
            },
            {
                "command": "opentinker.doctor",
                "title": "Check Setup",
                "category": "OpenTinker",
                "icon": "$(pulse)"
            },
            {
                "command": "opentinker.getStarted",
                "title": "Get Started",
                "category": "OpenTinker",
                "icon": "$(book)"
            },
            {
                "command": "opentinker.generateModelHints",
                "title": "Generate Model Hints (Autocomplete)",
                "category": "OpenTinker"
            },
            {
                "command": "opentinker.showLogs",
                "title": "Follow Laravel Log",
                "category": "OpenTinker"
            },
            {
                "command": "opentinker.stopLogs",
                "title": "Stop Following Laravel Log",
                "category": "OpenTinker"
            },
            {
                "command": "opentinker.clearOutput",
                "title": "Clear Results",
                "category": "OpenTinker"
            },
            {
                "command": "opentinker.focusOutput",
                "title": "Show Results",
                "category": "OpenTinker"
            },
            {
                "command": "opentinker.openRecent",
                "title": "Open Recent Run",
                "category": "OpenTinker"
            },
            {
                "command": "opentinker.runCallable",
                "title": "Run Callable",
                "category": "OpenTinker"
            },
            {
                "command": "opentinker.tinkerModel",
                "title": "Tinker This Model",
                "category": "OpenTinker"
            }
        ],
        "keybindings": [
            {
                "command": "opentinker.run",
                "key": "ctrl+enter",
                "mac": "cmd+enter",
                "when": "editorTextFocus && opentinker.isScratch"
            },
            {
                "command": "opentinker.runSelection",
                "key": "ctrl+shift+enter",
                "mac": "cmd+shift+enter",
                "when": "editorTextFocus && editorLangId == php"
            },
            {
                "command": "opentinker.stop",
                "key": "ctrl+alt+c",
                "mac": "cmd+alt+c",
                "when": "opentinker.running"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "opentinker",
                    "title": "OpenTinker",
                    "icon": "media/opentinker.svg"
                }
            ],
            "panel": [
                {
                    "id": "opentinkerPanel",
                    "title": "OpenTinker",
                    "icon": "media/opentinker.svg"
                }
            ]
        },
        "views": {
            "opentinker": [
                {
                    "id": "opentinker.main",
                    "name": "Tinker"
                }
            ],
            "opentinkerPanel": [
                {
                    "type": "webview",
                    "id": "opentinker.results",
                    "name": "Results",
                    "when": "config.opentinker.results.location == panel"
                }
            ]
        },
        "menus": {
            "editor/title/run": [
                {
                    "command": "opentinker.runFile",
                    "when": "opentinker.isScratch && !opentinker.running",
                    "group": "navigation@0"
                },
                {
                    "command": "opentinker.stop",
                    "when": "opentinker.isScratch && opentinker.running",
                    "group": "navigation@0"
                }
            ],
            "editor/context": [
                {
                    "command": "opentinker.runSelection",
                    "when": "editorLangId == php",
                    "group": "opentinker@1"
                },
                {
                    "command": "opentinker.saveSnippet",
                    "when": "editorLangId == php && editorHasSelection",
                    "group": "opentinker@2"
                }
            ],
            "view/title": [
                {
                    "command": "opentinker.open",
                    "when": "view == opentinker.main",
                    "group": "navigation@0"
                },
                {
                    "command": "opentinker.newScratch",
                    "when": "view == opentinker.main",
                    "group": "navigation@1"
                },
                {
                    "command": "opentinker.selectTarget",
                    "when": "view == opentinker.main",
                    "group": "navigation@2"
                },
                {
                    "command": "opentinker.searchHistory",
                    "when": "view == opentinker.main",
                    "group": "navigation@3"
                },
                {
                    "command": "opentinker.getStarted",
                    "when": "view == opentinker.main",
                    "group": "1_setup@0"
                },
                {
                    "command": "opentinker.doctor",
                    "when": "view == opentinker.main",
                    "group": "1_setup@1"
                },
                {
                    "command": "opentinker.generateModelHints",
                    "when": "view == opentinker.main",
                    "group": "1_setup@2"
                },
                {
                    "command": "opentinker.runClipboard",
                    "when": "view == opentinker.main",
                    "group": "2_run@1"
                },
                {
                    "command": "opentinker.showLogs",
                    "when": "view == opentinker.main",
                    "group": "2_run@2"
                },
                {
                    "command": "opentinker.clearHistory",
                    "when": "view == opentinker.main",
                    "group": "3_history@1"
                }
            ],
            "view/item/context": [
                {
                    "command": "opentinker.editTarget",
                    "when": "view == opentinker.main && viewItem == target",
                    "group": "inline"
                },
                {
                    "command": "opentinker.openSnippet",
                    "when": "view == opentinker.main && viewItem == snippet",
                    "group": "inline"
                },
                {
                    "command": "opentinker.selectTargetForFile",
                    "when": "view == opentinker.main && viewItem == scratch",
                    "group": "1_target"
                },
                {
                    "command": "opentinker.saveSnippet",
                    "when": "view == opentinker.main && viewItem == group-snippets",
                    "group": "inline"
                },
                {
                    "command": "opentinker.newScratch",
                    "when": "view == opentinker.main && viewItem == group-scratch",
                    "group": "inline"
                }
            ],
            "commandPalette": [
                {
                    "command": "opentinker.openRecent",
                    "when": "false"
                },
                {
                    "command": "opentinker.runCallable",
                    "when": "false"
                },
                {
                    "command": "opentinker.tinkerModel",
                    "when": "false"
                },
                {
                    "command": "opentinker.rerun",
                    "when": "false"
                }
            ],
            "editor/title": [
                {
                    "command": "opentinker.runFile",
                    "when": "opentinker.isScratch && !opentinker.running",
                    "group": "navigation@-100"
                },
                {
                    "command": "opentinker.stop",
                    "when": "opentinker.isScratch && opentinker.running",
                    "group": "navigation@-100"
                }
            ]
        },
        "configuration": {
            "title": "OpenTinker",
            "properties": {
                "opentinker.docker.workingDir": {
                    "type": "string",
                    "default": "/var/www",
                    "description": "Default project path inside containers for new targets. Detection usually works this out from your Compose file."
                },
                "opentinker.php.binary": {
                    "type": "string",
                    "default": "php",
                    "scope": "machine-overridable",
                    "description": "PHP binary for local targets."
                },
                "opentinker.ssh.phpBinary": {
                    "type": "string",
                    "default": "php",
                    "description": "PHP binary used on the SSH execution host."
                },
                "opentinker.scratchDir": {
                    "type": "string",
                    "default": ".tinker",
                    "description": "Directory (relative to the workspace) for scratch files. Reload the window after changing it."
                },
                "opentinker.executionMode": {
                    "type": "string",
                    "enum": [
                        "statements",
                        "file"
                    ],
                    "enumDescriptions": [
                        "Execute scratch files statement by statement so every line gets its own result card.",
                        "Execute the whole file as a single statement card."
                    ],
                    "default": "statements",
                    "description": "How scratch files run: statement by statement (a card per line) or as one block."
                },
                "opentinker.timeoutMs": {
                    "type": "number",
                    "default": 30000,
                    "description": "Stop a run after this many milliseconds (0 to disable). With fresh sessions the worker stays running."
                },
                "opentinker.maxOutputBytes": {
                    "type": "number",
                    "default": 2097152,
                    "description": "Maximum bytes of rendered output the webview keeps per run."
                },
                "opentinker.history.maxEntries": {
                    "type": "number",
                    "default": 50,
                    "minimum": 1,
                    "maximum": 200,
                    "description": "Maximum number of run records stored for this workspace. Code and run metadata are retained."
                },
                "opentinker.history.persistResults": {
                    "type": "boolean",
                    "default": false,
                    "description": "Retain bounded result frames in workspace state across reloads. Results can contain sensitive application data."
                },
                "opentinker.session.mode": {
                    "type": "string",
                    "enum": [
                        "fresh",
                        "keep"
                    ],
                    "enumDescriptions": [
                        "Every run starts from a freshly booted app, like running a script. Nothing leaks between runs.",
                        "Variables and imports carry over between runs, like a REPL."
                    ],
                    "default": "fresh",
                    "description": "How runs share state."
                },
                "opentinker.database.rollback": {
                    "type": "boolean",
                    "default": false,
                    "description": "Run code inside a database transaction and roll it back afterwards. Mail, queues, files and external calls are not rolled back."
                },
                "opentinker.fakeSideEffects": {
                    "type": "boolean",
                    "default": false,
                    "markdownDescription": "Fake mail, notifications, queued and dispatched jobs, and requests made with Laravel's `Http` client during runs, and show what each statement would have sent. Needs Laravel. Events, files, cache and SDKs with their own HTTP clients stay real. Pair it with `#opentinker.database.rollback#` to try changes safely."
                },
                "opentinker.production.confirm": {
                    "type": "string",
                    "enum": [
                        "writes",
                        "always",
                        "never"
                    ],
                    "enumDescriptions": [
                        "Ask before running code that looks like it changes data or has side effects.",
                        "Ask before every run on production.",
                        "Never ask."
                    ],
                    "default": "writes",
                    "description": "When to confirm runs against a production environment (APP_ENV=production or a target marked production)."
                },
                "opentinker.results.location": {
                    "type": "string",
                    "enum": [
                        "beside",
                        "panel"
                    ],
                    "enumDescriptions": [
                        "Next to the scratch file, like Tinkerwell.",
                        "In the bottom panel next to Terminal."
                    ],
                    "default": "beside",
                    "description": "Where results are shown."
                },
                "opentinker.inlineResults": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show each statement's result at the end of its line."
                },
                "opentinker.codeLens.runMethods": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show Run method and Run function above public methods and functions that take no required arguments."
                },
                "opentinker.codeLens.tinkerModel": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show Tinker this model above Eloquent model classes."
                },
                "opentinker.bootstrap": {
                    "type": "string",
                    "default": "auto",
                    "description": "How the worker boots the project: auto, laravel, composer (plain PHP with Composer), or a path to a bootstrap file for other frameworks. Targets can override this."
                }
            }
        },
        "walkthroughs": [
            {
                "id": "getStarted",
                "title": "Get started with OpenTinker",
                "description": "Run PHP against your Laravel or PHP app and see what every line did.",
                "steps": [
                    {
                        "id": "run",
                        "title": "Run your first scratch file",
                        "description": "The Tinker window opens a scratch file beside its results. Write some PHP and press Cmd+Enter (Ctrl+Enter on Windows and Linux): each line's value appears at the end of the line, with model cards, tables and SQL in the results panel.\n[Open Tinker Window](command:opentinker.open)",
                        "media": {
                            "image": "media/walkthrough/run.jpg",
                            "altText": "A scratch file with values at the end of each line, and the results panel with a model card, a table and SQL."
                        },
                        "completionEvents": [
                            "onCommand:opentinker.run",
                            "onCommand:opentinker.runFile"
                        ]
                    },
                    {
                        "id": "target",
                        "title": "Choose where code runs",
                        "description": "The first run finds your app by itself: a Docker Compose service (Sail included), a running container, or local PHP. Add an SSH server, or give one scratch file its own target. Production targets turn red.\n[Choose Target](command:opentinker.selectTarget)",
                        "media": {
                            "image": "media/walkthrough/targets.jpg",
                            "altText": "The target form, with Docker Compose, Docker container, local PHP and SSH runtimes."
                        },
                        "completionEvents": [
                            "onCommand:opentinker.selectTarget",
                            "onCommand:opentinker.selectTargetForFile",
                            "onCommand:opentinker.newTarget"
                        ]
                    },
                    {
                        "id": "safety",
                        "title": "Try changes safely",
                        "description": "Roll back database changes after each run, and fake mail, notifications, jobs and Laravel HTTP client calls to see what they would have sent without sending anything. On production, OpenTinker asks before code that writes.\n[Toggle Rollback](command:opentinker.toggleRollback)\n[Toggle Fake Side Effects](command:opentinker.toggleFakes)",
                        "media": {
                            "image": "media/walkthrough/safety.jpg",
                            "altText": "A result card listing an email and an HTTP request that were faked instead of sent."
                        },
                        "completionEvents": [
                            "onCommand:opentinker.toggleRollback",
                            "onCommand:opentinker.toggleFakes"
                        ]
                    },
                    {
                        "id": "anywhere",
                        "title": "Run code from anywhere",
                        "description": "Cmd+Shift+Enter (Ctrl+Shift+Enter) runs the selection or current line of any PHP file. CodeLens can tinker a model or run a method, and snippets with inputs live in .tinker/snippets for your team to share.\n[Save Snippet](command:opentinker.saveSnippet)",
                        "media": {
                            "markdown": "media/walkthrough/anywhere.md"
                        },
                        "completionEvents": [
                            "onCommand:opentinker.runSelection",
                            "onCommand:opentinker.saveSnippet",
                            "onCommand:opentinker.runSnippet"
                        ]
                    },
                    {
                        "id": "setup",
                        "title": "Check your setup",
                        "description": "Check Setup starts your target, reports the PHP, Laravel and PsySH versions, and looks for keymap and Intelephense conflicts.\n[Check Setup](command:opentinker.doctor)",
                        "media": {
                            "markdown": "media/walkthrough/setup.md"
                        },
                        "completionEvents": [
                            "onCommand:opentinker.doctor"
                        ]
                    }
                ]
            }
        ],
        "viewsWelcome": [
            {
                "view": "opentinker.main",
                "contents": "OpenTinker runs PHP against your Laravel or PHP app, line by line. Open the project's folder to start.\n[Open Folder](command:vscode.openFolder)"
            }
        ]
    },
    "scripts": {
        "build": "node esbuild.mjs",
        "watch": "node esbuild.mjs --watch",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.webview.json",
        "lint": "eslint src test",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "package": "vsce package --no-dependencies",
        "vscode:prepublish": "npm run build",
        "build:worker": "node scripts/build-worker.mjs",
        "test:worker": "php test/workerFeatures.php",
        "test:integration": "node scripts/build-worker.mjs && php test/integration/worker.php"
    },
    "devDependencies": {
        "@types/node": "^22.13.5",
        "@types/vscode": "~1.90.0",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/vsce": "^3.2.2",
        "esbuild": "^0.25.0",
        "eslint": "^9.19.0",
        "eslint-config-prettier": "^10.0.1",
        "happy-dom": "^20.14.5",
        "prettier": "^3.4.2",
        "prettier-plugin-organize-imports": "^4.1.0",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.23.0",
        "vitest": "^3.0.5"
    }
}
