# Allowlist: package only what the extension needs at runtime, so local files
# (scratch files, .env, coverage, source maps) can never end up in the VSIX.
# package.json is always included.
**
!dist/extension.js
!dist/worker.php
!dist/webview/results.js
!dist/webview/results.css
!media/icon.png
!media/opentinker.svg
!media/walkthrough/**
!README.md
!CHANGELOG.md
!LICENSE
